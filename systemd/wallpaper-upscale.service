[Unit]
Description=Real-ESRGAN batch upscale of sub-screen gallery images (RTX 5090 D Vulkan)
After=graphical-session.target
# Refresh the slideshow once the batch finishes so the new SR images go live.
Wants=wallpaper-slideshow.service
# Wallpaper generation does not depend on this finishing; it runs independently
# and reads the manifest produced here.

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/gnome-wallpaper-slideshow/config
# Move ultra-low-res images (any dimension < MIN_DIMENSION) to a recoverable
# quarantine and drop their SR cache before the batch scans the gallery.
ExecStartPre=%h/.local/bin/prune-lowres
ExecStart=%h/.local/bin/upscale-wallpapers
# Regenerate the slideshow (debounce-aware; oneshot) after the manifest updates.
ExecStartPost=%h/.local/bin/make-slideshow --force
# Long batch on ~125 images at a few seconds each; give it headroom.
TimeoutStartSec=3600
# GPU job: never enter a failed-restart throttle; the timer drives cadence.
StartLimitIntervalSec=0
