[Unit]
Description=Regenerate GNOME wallpaper slideshow from the gallery folder
# Needs the graphical session bus for gsettings; waits for it if the path
# unit fires early during login.
After=graphical-session.target
Wants=graphical-session.target
# Default gallery; install.sh rewrites this line if GALLERY_DIR is customized.
ConditionPathIsDirectory=%h/Documents/1_Gallery/b_Processed

[Service]
Type=oneshot
# Optional config; the leading "-" means "no error if the file is absent".
# Overrides GALLERY_DIR / timings consumed by the generator script.
EnvironmentFile=-%h/.config/gnome-wallpaper-slideshow/config
ExecStart=%h/.local/bin/make-slideshow
# A bulk download can emit hundreds of inotify events in seconds. oneshot
# re-queues them; coalesce the burst with a short settle delay, and never
# enter the failed-restart throttle for this harmless job.
ExecStartPre=/usr/bin/sleep 2
StartLimitIntervalSec=0
TimeoutStartSec=120
