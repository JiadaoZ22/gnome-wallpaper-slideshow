# gnome-wallpaper-slideshow user configuration
# Installed to ~/.config/gnome-wallpaper-slideshow/config and read by the
# systemd services (EnvironmentFile). Plain KEY=value, no `export`.
# Re-run `systemctl --user start wallpaper-slideshow.service` after editing.

# Folder scanned for images (recursive). Temporary/partial downloads and
# non-image files are skipped automatically.
GALLERY_DIR=~/Documents/1_Gallery/b_Processed

# How long each image stays, and the cross-fade length, in seconds.
# Desktop: the Wallpaper Ease shell extension uses these to drive a 60fps
#   EASE_IN_OUT_CUBIC (iOS-style S-curve) crossfade — see README. It reads the
#   generated extension-config.json (interval_ms/fade_ms), so changes here take
#   effect on the next slideshow regeneration, no shell reload needed.
# Lock screen / fallback: the native GNOME XML slideshow uses the same values,
#   but its crossfade is a 1 Hz linear blend with no easing.
DURATION=17.5
TRANSITION=2.5

# GNOME picture placement. 'scaled' = contain fit: the whole image is visible,
# its aspect ratio is preserved (never stretched), and any unfilled area gets
# black bars; nothing is cropped. Alternatives: zoom | centered | stretched | none
PICTURE_OPTIONS=scaled

# 1 = also set the same slideshow on the lock screen (org.gnome.desktop.screensaver)
SET_LOCKSCREEN=1

# 1 = reshuffle order on every regeneration; 0 = deterministic sorted order
RANDOM=1

# Comma-separated image extensions to include (lower-case, no dots).
EXTENSIONS=jpg,jpeg,png,webp,bmp,gif

# Number of historical versioned XML files kept alongside the live one.
KEEP=5

# Coalesce inotify bursts: skip a regeneration if the newest XML is younger
# than this many seconds (the daily timer still forces a rebuild). Set 0 to
# disable. Override a single run with: make-slideshow --force
DEBOUNCE=20

# --- Screen-fitted wallpaper cache (anti-stutter) ---------------------------
# Camera/source images are often 16-80 MP, far larger than a 4K panel's 8.3 MP.
# GNOME Shell decodes each wallpaper on its render thread, so those oversized
# files caused multi-hundred-ms frame stalls during the crossfade. Before each
# playlist build, bin/downscale-wallpapers fits every image to the monitor's
# long edge (no crop, no upscale) into the CACHE_DIR OUTSIDE the gallery and the
# playlist points at those JPEGs. The originals in GALLERY_DIR are never touched.
#
# DOWNSCALE_ENABLED=1 refreshes the cache on every regeneration (incremental:
# unchanged images are skipped). Set 0 to keep using whatever cache exists.
DOWNSCALE_ENABLED=1
# Output cache location and its manifest. Keep CACHE_DIR outside GALLERY_DIR so
# the inotify watcher does not react to the cache's own writes.
# CACHE_DIR=~/.local/share/backgrounds/wallpaper-cache
# DOWNSCALE_MANIFEST=~/.local/state/gnome-wallpaper-slideshow/downscale-manifest.json
# Target long edge in pixels. 0 = auto-detect the primary monitor (xrandr),
# falling back to 3840 headless.
# TARGET_LONG_EDGE=0
# JPEG_QUALITY=88
# MAX_WORKERS=0   # 0 = min(CPU count, 8) parallel encoders

# NOTE: super-resolution and low-res pruning live in the separate
# image-quality-toolkit repo. When installed, its wallpaper-upscale.service
# reads this same file for GALLERY_DIR (and any SR_*/MIN_DIMENSION overrides you
# add) and writes the SR manifest make-slideshow consumes — no SR keys here.
