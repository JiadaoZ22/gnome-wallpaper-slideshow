#!/usr/bin/env python3
"""Quarantine ultra-low-resolution gallery images.

Standing rule: any image whose width OR height is below MIN_DIMENSION is too
low-res to display on the 4K screen even after super-resolution, so it is moved
out of the watched gallery. This tool MOVES rather than hard-deletes: files go
to a dated sibling quarantine folder (outside the gallery so the inotify watch
does not re-add them), relative paths are preserved, and a JSON + text manifest
is written so the operation is fully reversible.

It also removes the quarantined images' entries from the SR manifest and their
cached prepared outputs, so no stale reference can reach the slideshow.

Config (environment, normally supplied by the systemd EnvironmentFile):
  GALLERY_DIR      source gallery (default ~/Documents/1_Gallery/b_Processed)
  MIN_DIMENSION    pixels; quarantine when w < this OR h < this (0 disables)
  CACHE_DIR        SR cache root
  MANIFEST         SR manifest path
  EXTENSIONS       comma-separated extensions to consider

Flags:
  --dry-run   report what would be quarantined without moving anything
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import shutil
import sys
from pathlib import Path

from PIL import Image

DEFAULTS = {
    "GALLERY_DIR": "~/Documents/1_Gallery/b_Processed",
    "MIN_DIMENSION": "1080",
    "CACHE_DIR": "~/.local/share/gnome-wallpaper-slideshow/upscaled",
    "MANIFEST": "~/.local/state/gnome-wallpaper-slideshow/upscale-manifest.json",
    "EXTENSIONS": "jpg,jpeg,png,webp,bmp,gif",
}
EXCLUDE_SUFFIXES = (".aliyunpan-downloading", ".part", ".tmp", ".download",
                    ".crdownload", "~")


def env(key: str) -> str:
    val = os.environ.get(key)
    return val if val not in (None, "") else os.path.expanduser(DEFAULTS[key])


def dims(p: Path):
    try:
        with Image.open(p) as im:
            return im.size
    except Exception:
        return None


def main() -> int:
    ap = argparse.ArgumentParser(description="Quarantine sub-MIN_DIMENSION gallery images.")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    gallery = Path(os.path.expanduser(env("GALLERY_DIR")))
    min_dim = int(env("MIN_DIMENSION"))
    cache_dir = Path(os.path.expanduser(env("CACHE_DIR")))
    manifest_path = Path(os.path.expanduser(env("MANIFEST")))
    exts = {e.strip().lower() for e in env("EXTENSIONS").split(",") if e.strip()}

    if min_dim <= 0:
        print(f"MIN_DIMENSION={min_dim} -> pruning disabled; nothing to do.")
        return 0
    if not gallery.is_dir():
        print(f"gallery not found: {gallery}")
        return 0  # never block the SR service on a missing gallery

    offenders = []
    for root, _, files in os.walk(gallery):
        for name in files:
            if name.startswith(".") or name.lower().endswith(EXCLUDE_SUFFIXES):
                continue
            if name.lower().rsplit(".", 1)[-1] not in exts:
                continue
            src = Path(root) / name
            d = dims(src)
            if not d:
                continue
            w, h = d
            if w < min_dim or h < min_dim:
                offenders.append((src, w, h))

    print(f"scanned {gallery}: {len(offenders)} image(s) with any dimension < {min_dim}")
    if not offenders:
        return 0
    if args.dry_run:
        for src, w, h in sorted(offenders, key=lambda t: min(t[1], t[2])):
            print(f"  DRY-RUN {w}x{h}  {src.relative_to(gallery)}")
        return 0

    ts = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    quarantine = gallery.parent / f"_lowres_quarantine_{ts}"
    records = []
    for src, w, h in sorted(offenders, key=lambda t: min(t[1], t[2])):
        rel = src.relative_to(gallery)
        dst = quarantine / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        st = src.stat()
        shutil.move(str(src), str(dst))
        records.append({
            "rel": str(rel), "src": str(src), "dst": str(dst),
            "w": w, "h": h, "bytes": st.st_size,
            "mtime": int(st.st_mtime),
            "reason": f"dimension < {min_dim} (got {w}x{h})",
        })
        print(f"  MOVED {w}x{h}  {rel}")

    quarantine.mkdir(parents=True, exist_ok=True)
    (quarantine / "manifest.json").write_text(
        json.dumps({"created": ts, "min_dimension": min_dim,
                    "gallery": str(gallery), "count": len(records),
                    "items": records}, indent=2), encoding="utf-8")
    lines = [f"# Low-res quarantine {ts} (any dimension < {min_dim})",
             f"# gallery: {gallery}", f"# count: {len(records)}",
             "# to restore: move each dst back to src (see manifest.json)"]
    for r in records:
        lines.append(f'{r["w"]}x{r["h"]}\t{r["dst"]}\t<- {r["src"]}')
    (quarantine / "manifest.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")

    # Purge SR manifest entries and cached outputs for the moved images.
    rels = {r["rel"] for r in records}
    if manifest_path.exists():
        try:
            manifest = json.loads(manifest_path.read_text())
        except Exception:
            manifest = {}
        removed = [k for k in rels if k in manifest]
        for k in removed:
            manifest.pop(k, None)
        if removed:
            tmp = manifest_path.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
            os.replace(tmp, manifest_path)
            print(f"removed {len(removed)} entr(ies) from {manifest_path.name}")
    for rel in rels:
        key = hashlib.sha1(rel.encode("utf-8")).hexdigest()[:16]
        out_dir = cache_dir / key
        if out_dir.exists():
            shutil.rmtree(out_dir, ignore_errors=True)
            print(f"removed cache {out_dir.name} for {rel}")

    print(f"quarantined {len(records)} image(s) -> {quarantine}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
